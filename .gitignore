# Claude config & tooling — treated as personal/local, not shared.
# (Note: .claude-plugin/ is a different directory and stays tracked.)
.claude/

# Explicit onboard state-file entries required by the CI guard
# (.github/scripts/check-state-gitignore.sh) — these persist wizard answers
# that may contain user-entered secrets. Redundant with .claude/ above but
# the guard greps for these exact lines.
.claude/onboard-snapshot.json
.claude/onboard-meta.json

# OS
.DS_Store
Thumbs.db

# Editors/IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Dependencies & build (future-proofing)
node_modules/
dist/
build/
__pycache__/
*.pyc

# Local planning docs
future-plans/
docs/
.superpowers/
# walkthrough rendered docs (may contain session content)
.claude/walkthrough/

# handoff directives (may contain session content)
.claude/handoff/

# Local session/tooling state. All redundant with .claude/ above; listed
# explicitly so the intent survives if that blanket line is ever narrowed.
# lens review settings + state (rendered reviews go to the configured outputPath, e.g. docs/reviews/)
.claude/lens/
# matali's isolated feature checkouts + its per-run pipeline state
.claude/worktrees/
.claude/matali/state/

# matali worktree seed-file manifest — local tooling config, not marketplace content
.worktreeinclude
